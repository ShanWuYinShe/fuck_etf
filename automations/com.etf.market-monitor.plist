		<string>__PROJECT_DIR__/monitor.sh</string>
		<string>--until-close</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>1</integer>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>25</integer>
		</dict>
